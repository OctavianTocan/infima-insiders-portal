{
  "name": "infima-games-insiders-signup-cloudflare-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "cf-typegen": "wrangler types",
    "postinstall": "npm run cf-typegen",
    "typecheck": "npm run cf-typegen && vite typegen && tsc -b",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "dev:staging": "wrangler dev --env staging --local",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "deploy:production": "npm run build:production && wrangler deploy",
    "deploy:staging": "npm run build:staging && wrangler deploy",
    "deploy": "echo 'Please specify environment: npm run deploy:staging or npm run deploy:production' && exit 1",
    "secrets:deploy:production": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-secrets.ps1",
    "secrets:deploy:staging": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-secrets-staging.ps1",
    "secrets:deploy": "echo 'Please specify environment: npm run secrets:deploy:staging or npm run secrets:deploy:production' && exit 1",
    "secrets:list:production": "wrangler secret list",
    "secrets:list:staging": "wrangler secret list --env staging",
    "secrets:list": "echo 'Please specify environment: npm run secrets:list:staging or npm run secrets:list:production' && exit 1"
  },
  "dependencies": {
    "isbot": "^5.1.27",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.7.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.1",
    "@cloudflare/vite-plugin": "^1.0.12",
    "@react-router/dev": "^7.7.1",
    "@storybook/addon-a11y": "^9.1.8",
    "@storybook/addon-docs": "^9.1.8",
    "@storybook/addon-onboarding": "^9.1.8",
    "@storybook/addon-vitest": "^9.1.8",
    "@storybook/react-vite": "^9.1.8",
    "@types/node": "^20",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "playwright": "^1.55.1",
    "storybook": "^9.1.8",
    "storybook-addon-remix-react-router": "^5.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "wrangler": "^4.39.0"
  },
  "overrides": {
    "@npmcli/git": "6.0.3",
    "@npmcli/package-json": "6.2.0"
  }
}
