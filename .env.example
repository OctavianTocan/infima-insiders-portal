# --Discord Variables--
# You can get these variables by creating an application on the Discord developer portal: https://discord.com/developers/applications
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
# You can get your Guild ID by enabling Developer Mode in Discord settings, right-clicking your server icon, and selecting "Copy ID". (You'll need to have the Discord bot or application that you've made in the server for all this to work.)
DISCORD_GUILD_ID=YOUR_DISCORD_GUILD_ID
DISCORD_VERIFIED_ROLE_ID=YOUR_DISCORD_VERIFIED_ROLE_ID
# This should be the same as the Redirect URI you set in your Discord application settings.
DISCORD_REDIRECT_URI=YOUR_DISCORD_REDIRECT_URI

# --GitHub Variables--
# This is the repository that you'll be adding people to. Just the name, not the full URL. For example, if your repo is at https://github.com/your-username/your-repo, then you would just put "your-repo" here.
GITHUB_REPO_NAME=YOUR_GITHUB_REPO_NAME
# This is the owner of the repository. This can be either your GitHub username or the name of an organization that the repository belongs to.
GITHUB_REPO_OWNER=YOUR_GITHUB_REPO_OWNER
# You can create a Personal Access Token (PAT) by going to https://github.com/settings/tokens and generating a new token with the appropriate scopes (like "repo" and "read:org").
GITHUB_PAT=YOUR_GITHUB_PAT
# You can get these variables by creating an OAuth App on the GitHub developer settings page: https://github.com/settings/developers (Click "New OAuth App" and fill in the required details. The Authorization callback URL should match the redirect URI used in your application.)
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID

# --Slack Variables--
# These values power webhook notifications and direct messages when signups or support requests occur.
SLACK_WEBHOOK_URL=YOUR_SLACK_WEBHOOK_URL
# Bot token requires "chat:write" and "im:write" scopes in Slack.
SLACK_BOT_TOKEN=YOUR_SLACK_BOT_TOKEN
# Admin Slack user ID receives DM notifications (e.g. U1234567890).
ADMIN_SLACK_USER_ID=YOUR_ADMIN_SLACK_USER_ID