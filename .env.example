# This Cloudflare Worker helps onboard users who have a specific role in a Discord server on to a GitHub repository.
# Here's how it works:
# 1. User authenticates with Discord OAuth
# 2. System verifies user has required role in Discord server
# 3. User authenticates with GitHub OAuth
# 4. System adds user as collaborator to private repository
# 5. Optional notifications sent to Slack

# SECURITY NOTE: All variables marked as [SECRET] should never be committed
# to version control or shared publicly. Use Cloudflare Workers secrets for
# production deployment.

# This is necessary for Cloudflare Workers using Vite, or else deploys always default to production. You can learn more about this here: https://developers.cloudflare.com/workers/vite-plugin/reference/cloudflare-environments/
CLOUDFLARE_ENV=production

===========================
#---DISCORD INTEGRATION---#
===========================
# Important: You will NEED to create a custom Discord Application (a bot) and invite it to your server with the "bot" scope and the "Read Messages/View Channels" and "Send Messages" permissions. You can follow this guide to create a bot and invite it to your server: https://www.discordjs.guide/legacy/preparations/app-setup
# Create the application at: https://discord.com/developers/applications

# IMPORTANT: You must also create a bot for your application to access
# guild member information. Go to Bot > Add Bot.

# [SECRET] Discord application client ID
# Found on your Discord application's "General Information" tab
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID

# [SECRET] Discord application client secret
# Found on your Discord application's "General Information" tab
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET

# [SECRET] Discord bot token
# Found on your Discord application's "Bot" tab
# Required for: Checking user roles in your server
# Bot needs: "Identify" and "Guild Members" privileged intents
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN

# Discord server (guild) ID where verification happens
# How to get: Enable Developer Mode in Discord settings > Right-click server icon > "Copy ID"
# Format: Numeric string (e.g., "123456789012345678")
DISCORD_GUILD_ID=YOUR_DISCORD_GUILD_ID

# ID of the role that grants access to the GitHub repository
# How to get: Enable Developer Mode > Right-click role in server settings > "Copy ID"
# Format: Numeric string (e.g., "123456789012345678")
DISCORD_VERIFIED_ROLE_ID=YOUR_DISCORD_VERIFIED_ROLE_ID

# URL where Discord redirects after authentication
# Must exactly match the redirect URI in your Discord application settings (one of them, you can have multiple)
# Typically, this would be your deployed Cloudflare Worker URL with the path "/api/discord/callback"
# Example: "https://your-domain.com/api/discord/callback"
DISCORD_REDIRECT_URI=YOUR_DISCORD_REDIRECT_URI

===========================
#---GITHUB INTEGRATION---#
===========================
# Required for GitHub OAuth authentication and repository access management.
# Create OAuth app at: https://github.com/settings/developers
# Create Personal Access Token at: https://github.com/settings/tokens

# [SECRET] GitHub OAuth application client ID
# Found on your GitHub OAuth app's "General" settings page
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID

# [SECRET] GitHub OAuth application client secret
# Found on your GitHub OAuth app's "General" settings page
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET

# [SECRET] GitHub Personal Access Token (PAT)
# Required for: Adding users as collaborators to the repository
# Scopes needed: "repo" (full control of private repositories), "read:org" (read org membership)
# Create at: https://github.com/settings/tokens
GITHUB_PAT=YOUR_GITHUB_PAT

# Name of the repository to grant access to (without owner)
# Example: If repo is at https://github.com/your-org/private-repo, use "private-repo"
GITHUB_REPO_NAME=YOUR_GITHUB_REPO_NAME

# Owner of the repository (username or organization)
# Example: If repo is at https://github.com/your-org/private-repo, use "your-org"
GITHUB_REPO_OWNER=YOUR_GITHUB_REPO_OWNER

===========================
#---SLACK INTEGRATION---#
===========================

# Used for notifications when users complete signup or request support.
# All Slack variables are optional, the system will work without them.

# [SECRET] Slack incoming webhook URL
# Purpose: Sends notifications to a channel when users complete signup
# Create at: https://api.slack.com/messaging/webhooks
# Format: "https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX"
SLACK_WEBHOOK_URL=YOUR_SLACK_WEBHOOK_URL
